# Optional runtime configuration for source selection and app defaults.
# The app loads this file automatically from the workspace root when present.

[app]
app_name = "Sports Replay POC"
referee_window_title = "Sports Replay Referee"
operator_window_title = "Sports Replay Operator"
base_data_dir = "C:\\SportsReplay"
# "development" hides the python_push transitional banner; "production"
# surfaces it as a high-contrast warning so refactors don't accidentally
# regress feeds back to Python push.
app_mode = "development"
# Slice 3.A.3 escape hatch. When true, NATIVE sources still use the
# legacy appsink → QImage preview path. Useful if d3d11videosink
# misbehaves on the local hardware (third window appearing, tee
# fan-out freezes); cost is a Python-bound preview path.
force_python_push_preview = false
# Dev defaults at 720p@30. With both Phase 4 (native segmented
# recording) and slice 3.A.3 (native preview) done, raising these to
# 1080p@30 is safe for NATIVE sources.
target_frame_width = 1280
target_frame_height = 720
target_fps = 30.0
# Live audio monitor (the speakers play whatever the source is sending).
# Turn off if your source loops back into your own NDI sender (Screen
# Capture etc.) — otherwise you get an audio feedback loop.
enable_embedded_audio = true
live_audio_monitor_enabled = true
audio_bitrate = 128000

[media]
# Phase 11.A: encoder selection for the recording branch.
#   "auto"   — probe and use the best hwaccel encoder available, fall back to software
#   "none"   — pin to software encoding regardless of what's installed
#   "intel"  — prefer Intel QuickSync (`qsvjpegenc` for MJPEG)
#   "nvidia" — prefer NVIDIA NVENC (no MJPEG element on Windows; falls back to software)
#   "amd"    — prefer AMD AMF (no MJPEG element on Windows; falls back to software)
# Unrequested fallbacks emit a `hwaccel_fallback` INFO health event so
# the diagnostics widget shows what actually got picked.
hardware_acceleration = "auto"

# Phase 11.C — per-branch queue policy. Defaults reproduce the
# pre-11.C hardcoded behavior. Override any subset; missing keys
# stay at default. `leaky` is the GstQueueLeaky enum:
#   0 = no leak (block upstream)
#   1 = upstream (drop incoming)
#   2 = downstream (drop oldest, default)
# [media.queue_policy.preview]
# leaky = 2
# max_buffers = 4
# max_size_time_ms = 200

# The recording queue is non-leaky (disk pressure surfaces as a
# health event rather than dropping frames). `max_size_time_ms` is
# auto-derived from `recording_segment_duration_seconds` (one
# segment's worth of nanoseconds) unless set explicitly here.
# [media.queue_policy.recording]
# leaky = 0
# max_buffers = 256
# max_size_time_ms = 4000   # explicit override; auto-derived if omitted

[recording]
enabled = true
segment_duration_seconds = 4.0
# Live recording is MJPEG-in-MKV. Phase 11.B trialed ProRes/DNxHR
# in MOV containers but the qtmux late-pad-allocation behavior
# couldn't be reconciled with our software-encoder + NDI pipeline.
# For broadcast-archive deliverables (ProRes, DNxHR, H.264/MP4),
# use the post-session processor to transcode from the MJPEG-MKV
# master at export time.
codec = "mjpeg"
container = "mkv"

# Phase 11.C — per-codec encoder property overrides.
#   mjpeg.quality   — jpegenc / qsvjpegenc quality (1-100, default 85).
#   prores.profile  — avenc_prores_ks profile name: proxy | lt | standard | hq (default lt).
#   dnxhr.profile   — avenc_dnxhd profile name: lb | sq | hq (default lb).
# The encoder factory (`app/media/encoder_factory.py`) maps profile
# names to the integer enum values exposed by gst-libav. Higher
# profiles produce larger files at higher quality.
# [recording.encoder_settings.mjpeg]
# quality = 85
# [recording.encoder_settings.prores]
# profile = "lt"
# [recording.encoder_settings.dnxhr]
# profile = "lb"
# Slice 4.F: when true, audio is muxed into segment files alongside
# video. Sources with no audio (synthetic, NDI Tools Screen Capture)
# MUST set this to false — splitmuxsink stalls waiting for audio
# buffers that never arrive otherwise.
audio_enabled = true
# Phase 7.A: aggregate disk write budget in MB/s. The validator at
# startup compares estimated throughput (feed_count × resolution × fps
# × codec coefficient) against this number. 200 ≈ conservative SATA
# SSD; raise for NVMe, lower for spinning disks or shared volumes.
disk_budget_mb_s = 200.0

# Phase 12.B / 14.C — replay transport tuning. `frame_step_count`
# is the number of frames Step ◀ / Step ▶ jogs per click (default 1).
# `rewind_seconds` is the duration the referee window's Rewind button
# jogs back (default 5). The Rewind button label is built from this
# setting at construction time, so changing it is config-only — no
# code change required.
# [replay]
# frame_step_count = 1
# rewind_seconds = 5

# Production deployments use NDI (`kind = "ndi"`). The `synthetic` kind is the
# dev-time fallback for machines without NDI hardware. USB / OpenCV camera
# ingest was removed in Phase 2.5 — `kind = "auto"` is now an error.

[[feeds]]
feed_id = "ndi_main"
display_name = "Main Camera"
kind = "ndi"
ndi_name = "DAVIDI7 (Camera 1)"
enabled = true

[[feeds]]
feed_id = "ndi_angle"
display_name = "Angle 2"
kind = "ndi"
ndi_name = "DAVIDI7 (Camera 2)"
enabled = true

# Dev-only synthetic source for camera-less testing. Comment out for production.
# [[feeds]]
# feed_id = "feed_dev"
# display_name = "Synthetic Test Pattern"
# kind = "synthetic"
# enabled = true
