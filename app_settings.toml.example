# Optional runtime configuration for source selection and app defaults.
# The app loads this file automatically from the workspace root when present.

[app]
app_name = "Sports Replay POC"
operator_window_title = "Sports Replay Operator"
program_window_title = "Sports Replay Program"
base_data_dir = "C:\\SportsReplay"
# "development" hides the python_push transitional banner; "production"
# surfaces it as a high-contrast warning so refactors don't accidentally
# regress feeds back to Python push.
app_mode = "development"
# Dev defaults at 720p@30. Raising these is safe now that Phase 4 is
# done (recording is native via splitmuxsink); preview is still
# Python-bound until slice 3.A.3 lands (native preview video sink).
target_frame_width = 1280
target_frame_height = 720
target_fps = 30.0
# Live audio monitor (the speakers play whatever the source is sending).
# Turn off if your source loops back into your own NDI sender (Screen
# Capture etc.) — otherwise you get an audio feedback loop.
enable_embedded_audio = true
live_audio_monitor_enabled = true
audio_bitrate = 128000

[recording]
enabled = true
segment_duration_seconds = 4.0
codec = "mjpeg"
container = "mkv"
# Slice 4.F: when true, audio is muxed into segment files alongside
# video. Sources with no audio (synthetic, NDI Tools Screen Capture)
# MUST set this to false — splitmuxsink stalls waiting for audio
# buffers that never arrive otherwise.
audio_enabled = true

# Production deployments use NDI (`kind = "ndi"`). The `synthetic` kind is the
# dev-time fallback for machines without NDI hardware. USB / OpenCV camera
# ingest was removed in Phase 2.5 — `kind = "auto"` is now an error.

[[feeds]]
feed_id = "ndi_main"
display_name = "Main Camera"
kind = "ndi"
ndi_name = "DAVIDI7 (Camera 1)"
enabled = true

[[feeds]]
feed_id = "ndi_angle"
display_name = "Angle 2"
kind = "ndi"
ndi_name = "DAVIDI7 (Camera 2)"
enabled = true

# Dev-only synthetic source for camera-less testing. Comment out for production.
# [[feeds]]
# feed_id = "feed_dev"
# display_name = "Synthetic Test Pattern"
# kind = "synthetic"
# enabled = true

[source]
# Used only when no [[feeds]] entries are defined.
# Use "ndi" for production NDI cameras.
# Use "synthetic" for camera-less development.
kind = "synthetic"

# User-facing label shown in the UI and session metadata.
display_name = "Main Feed"
feed_id = "feed_main"

# Used when kind = "ndi". Format is `HOSTNAME (Source Name)`.
# Example:
# ndi_name = "OBS PGM"
ndi_name = ""
