# Optional runtime configuration for source selection and app defaults.
# The app loads this file automatically from the workspace root when present.

[app]
app_name = "Sports Replay POC"
operator_window_title = "Sports Replay Operator"
program_window_title = "Sports Replay Program"
base_data_dir = "C:\\SportsReplay"
target_frame_width = 640
target_frame_height = 360
target_fps = 15.0
replay_buffer_seconds = 120
# recording_filename = "session_recording.mp4"
# short_segments_subdir = "segments"
# short_segment_filename_prefix = "segment"

# Multi-feed (up to 8 enabled feeds). When present, [[feeds]] replaces the single [source] block below.
# Mix USB/webcam rows (kind = "auto") and NDI rows (kind = "ndi", ndi_name required).

[[feeds]]
feed_id = "cam_a"
display_name = "USB Cam A"
kind = "auto"
camera_index = 0
enabled = true

[[feeds]]
feed_id = "cam_b"
display_name = "USB Cam B"
kind = "auto"
camera_index = 1

[[feeds]]
feed_id = "ndi_1"
display_name = "NDI Program"
kind = "ndi"
ndi_name = "DAVIDI7 (Test Pattern)"

[source]
# Used only when no [[feeds]] entries are defined.
# Use "auto" to prefer the native webcam path and fall back automatically.
# Use "ndi" to connect to an NDI sender by name.
kind = "auto"

# User-facing label shown in the UI and session metadata.
display_name = "Main Feed"
feed_id = "feed_main"

# Used when kind = "auto".
camera_index = 0

# Used when kind = "ndi".
# Example:
# ndi_name = "OBS PGM"
ndi_name = ""
